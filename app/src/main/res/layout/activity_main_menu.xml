<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stage_amber"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/parchment_cream"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/espresso_outline"
            app:strokeWidth="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Enzo Magician Logo"
                    android:src="@drawable/ic_pawn" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="FINOPOLY"
                    android:textColor="@color/magic_teal"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="★ Personal Finance Management Game ★"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHighScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_magic_button_teal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:text="High Score: 0 pts"
                    android:textColor="@color/parchment_cream"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/llButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardHeader">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartGame"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="@color/magic_teal"
                android:drawableStart="@drawable/ic_money"
                android:drawableTint="@color/parchment_cream"
                android:paddingStart="24dp"
                android:text="@string/btn_start_game"
                android:textColor="@color/parchment_cream"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="@color/espresso_outline"
                app:strokeWidth="3dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHowToPlay"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/parchment_cream"
                android:drawableStart="@drawable/ic_quiz"
                android:drawableTint="@color/espresso_outline"
                android:paddingStart="24dp"
                android:text="@string/btn_how_to_play"
                android:textColor="@color/espresso_outline"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="@color/espresso_outline"
                app:strokeWidth="3dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMyBudget"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/parchment_cream"
                android:drawableStart="@drawable/ic_budget"
                android:drawableTint="@color/espresso_outline"
                android:paddingStart="24dp"
                android:text="@string/btn_my_budget"
                android:textColor="@color/espresso_outline"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="@color/espresso_outline"
                app:strokeWidth="3dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMyScore"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/parchment_cream"
                android:drawableStart="@drawable/ic_star_score"
                android:drawableTint="@color/espresso_outline"
                android:paddingStart="24dp"
                android:text="@string/btn_my_score"
                android:textColor="@color/espresso_outline"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="@color/espresso_outline"
                app:strokeWidth="3dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/parchment_cream"
                android:drawableStart="@drawable/ic_settings"
                android:drawableTint="@color/espresso_outline"
                android:paddingStart="24dp"
                android:text="Settings"
                android:textColor="@color/espresso_outline"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="@color/espresso_outline"
                app:strokeWidth="3dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#FFCDD2"
                android:drawableStart="@drawable/ic_expense"
                android:drawableTint="@color/finance_red"
                android:paddingStart="24dp"
                android:text="@string/btn_exit"
                android:textColor="@color/finance_red"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="@color/espresso_outline"
                app:strokeWidth="3dp" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>